---

---

<nav class="max-w-screen-xl mx-auto">

    <button
        id="nav-menu-toggle"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="nav-menu-panel"
        class="fixed top-8 right-8 z-50 flex h-10 w-10 flex-col items-center justify-center gap-1.5 cursor-pointer"
    >
        <span class="block h-0.5 w-6 rounded-full bg-slate-900 transition-transform duration-300 [button[aria-expanded=true]_&]:translate-y-2 [button[aria-expanded=true]_&]:rotate-45"></span>
        <span class="block h-0.5 w-6 rounded-full bg-slate-900 transition-opacity duration-300 [button[aria-expanded=true]_&]:opacity-0"></span>
        <span class="block h-0.5 w-6 rounded-full bg-slate-900 transition-transform duration-300 [button[aria-expanded=true]_&]:-translate-y-2 [button[aria-expanded=true]_&]:-rotate-45"></span>
    </button>

</nav>

<!-- Overlay -->
<div
    id="nav-menu-overlay"
    class="fixed inset-0 z-40 bg-slate-900/40 opacity-0 pointer-events-none transition-opacity duration-300"
></div>

<!-- Slide-out panel -->
<aside
    id="nav-menu-panel"
    class="fixed inset-y-0 left-0 z-40 w-[500px] max-w-[80vw] -translate-x-full bg-white shadow-xl transition-transform duration-300 ease-out"
    aria-hidden="true"
>
    <div class="pt-8">
        <div id="nav-profile" class="hidden flex-col items-center gap-2 text-center">
            <a href="/account" class="flex flex-col items-center border border-gray-300 rounded-full py-4 px-6 hover:shadow-md transition-shadow">
                <img id="nav-avatar" alt="" class="w-16 h-16 rounded-full" />
                <span id="nav-username" class="font-semibold"></span>
            </a>
        </div>

        <div class="flex flex-col gap-2 px-4 pt-8">
            <a href="/" id="nav-home" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-100 transition-colors">Home</a>
            <a href="/login" id="nav-login" class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-100 transition-colors">Log In</a>
            <a href="/account" id="nav-account" class="hidden items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-100 transition-colors">My Account</a>
        </div>
    </div>
</aside>

<script>
    import { supabase } from '../lib/supabase';
    import { avatars } from '../lib/avatars';

    const loginLink = document.querySelector<HTMLAnchorElement>('#nav-login');
    const accountLink = document.querySelector<HTMLAnchorElement>('#nav-account');
    const profileHeader = document.querySelector<HTMLAnchorElement>('#nav-profile');
    const profileAvatar = document.querySelector<HTMLImageElement>('#nav-avatar');
    const profileUsername = document.querySelector<HTMLSpanElement>('#nav-username');

    const {
        data: { session },
    } = await supabase.auth.getSession();

    if (session) {
        loginLink?.classList.add('hidden');
        accountLink?.classList.remove('hidden');
        accountLink?.classList.add('flex');
        profileHeader?.classList.remove('hidden');
        profileHeader?.classList.add('flex');

        const { data: profile } = await supabase
            .from('profiles')
            .select('username, avatar_id')
            .eq('id', session.user.id)
            .single();

        if (profile && profileAvatar && profileUsername) {
            const avatar = avatars[(profile.avatar_id ?? 1) - 1] ?? avatars[0];
            profileAvatar.src = avatar.src;
            profileUsername.textContent = profile.username || 'My Account';
        }
    }

    const toggle = document.querySelector<HTMLButtonElement>('#nav-menu-toggle');
    const panel = document.querySelector<HTMLElement>('#nav-menu-panel');
    const overlay = document.querySelector<HTMLElement>('#nav-menu-overlay');

    const openMenu = () => {
        toggle?.setAttribute('aria-expanded', 'true');
        toggle?.setAttribute('aria-label', 'Close menu');
        panel?.setAttribute('aria-hidden', 'false');
        panel?.classList.remove('-translate-x-full');
        overlay?.classList.remove('opacity-0', 'pointer-events-none');
        document.body.classList.add('overflow-hidden');
    };

    const closeMenu = () => {
        toggle?.setAttribute('aria-expanded', 'false');
        toggle?.setAttribute('aria-label', 'Open menu');
        panel?.setAttribute('aria-hidden', 'true');
        panel?.classList.add('-translate-x-full');
        overlay?.classList.add('opacity-0', 'pointer-events-none');
        document.body.classList.remove('overflow-hidden');
    };

    toggle?.addEventListener('click', () => {
        const isOpen = toggle.getAttribute('aria-expanded') === 'true';
        isOpen ? closeMenu() : openMenu();
    });

    overlay?.addEventListener('click', closeMenu);

    document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeMenu();
    });
</script>